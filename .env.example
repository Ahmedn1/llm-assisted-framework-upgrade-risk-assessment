# Copy to .env (git-ignored), fill in, then: set -a; source .env; set +a
# Nothing loads this file automatically. Empty values are ignored. See docs/configuration.md.

# --- LLM, generic: used by every LLM stage without its own values -------------
# Any OpenAI-compatible Chat Completions endpoint, hosted or local, e.g. https://api.openai.com/v1 or
# http://localhost:8000/v1 (vLLM), :8080/v1 (llama.cpp llama-server), :11434/v1 (Ollama), :1234/v1 (LM Studio).
# The key is optional for local servers.
LLM_MODEL_NAME=
LLM_BASE_URL=
LLM_API_KEY=

# --- LLM, per stage (override the generic values) ------------------------------
# A stage with its own BASE_URL is a separate provider: set its MODEL_NAME and API_KEY too.
# LLM-path collection (--path llm)
LLM_COLLECTION_MODEL_NAME=
LLM_COLLECTION_BASE_URL=
LLM_COLLECTION_API_KEY=
# Risk extraction
LLM_EXTRACTION_MODEL_NAME=
LLM_EXTRACTION_BASE_URL=
LLM_EXTRACTION_API_KEY=
# Verification critic (--verify-judge llm)
LLM_JUDGE_MODEL_NAME=
LLM_JUDGE_BASE_URL=
LLM_JUDGE_API_KEY=

# --- Decision model, generic: default is local LiquidAI/d1-3B at a pinned revision ---
# DECISION_BACKEND=d1 | jev   (a BASE_URL without a backend selects jev)
DECISION_BACKEND=
DECISION_MODEL_NAME=
DECISION_MODEL_REVISION=
DECISION_BASE_URL=
DECISION_API_KEY=

# --- Decision model, per stage (override the generic values) -------------------
# Resolver version-source scoring (--scorer decision)
DECISION_SCORER_BACKEND=
DECISION_SCORER_MODEL_NAME=
DECISION_SCORER_MODEL_REVISION=
DECISION_SCORER_BASE_URL=
DECISION_SCORER_API_KEY=
# Section relevance scoring of collected evidence
DECISION_RELEVANCE_BACKEND=
DECISION_RELEVANCE_MODEL_NAME=
DECISION_RELEVANCE_MODEL_REVISION=
DECISION_RELEVANCE_BASE_URL=
DECISION_RELEVANCE_API_KEY=
# Verification entailment judge (--verify-judge decision)
DECISION_JUDGE_BACKEND=
DECISION_JUDGE_MODEL_NAME=
DECISION_JUDGE_MODEL_REVISION=
DECISION_JUDGE_BASE_URL=
DECISION_JUDGE_API_KEY=

# --- Other services --------------------------------------------------------------
GITHUB_TOKEN=
BRAVE_SEARCH_API_KEY=
